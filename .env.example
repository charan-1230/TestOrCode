# TestOrCode environment configuration
# Copy this file to .env and fill in the values required for your setup.
# NEVER put real API keys in this file or commit .env to Git.

# ============================================================
# LLM PROVIDER
# ============================================================

# Examples: openai_compatible, gemini, ollama
# Day-1 setup: LLM_PROVIDER=gemini,
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, LLM_MODEL=gemini-3.5-flash
# Proposal candidates (section 13; NOT yet verified live - run scripts/provider_check.py first, it reports the
# returned dated model id and which LLM_STRUCTURED_MODE parses):
#   NVIDIA NIM:  LLM_PROVIDER=nim  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#                LLM_MODEL=qwen/qwen3-coder-480b-a35b-instruct | deepseek-ai/deepseek-v3.2 | openai/gpt-oss-120b
#   Mistral:     LLM_PROVIDER=mistral  LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=devstral-2512 (backup / model check)
# Keep a second model in its own file (e.g. .env.mistral, gitignored) and select it with --env-file.
LLM_PROVIDER=

# API key for the selected hosted provider.
# Leave empty only when the selected endpoint does not require a key.
LLM_API_KEY=
# Keys used one after another: when one key's daily quota is used up, the next one is used.
# Each key must come from a DIFFERENT Google Cloud project (the quota is per project).
LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=

# OpenAI-compatible API base URL.
# Set this to the endpoint provided by your selected provider.
# Leave empty when using the SDK's default endpoint.
LLM_BASE_URL=

# Exact model ID selected by the team.
# Use a dated/frozen model ID when the provider offers one.
# Do not use a changing "latest" alias for controlled experiments.
# How structured output is requested: json_schema (default), json_object or prompt.
# Replies are always validated against the Pydantic contract client-side.
LLM_STRUCTURED_MODE=

# Retries for rate limits, timeouts and 5xx (default 2), and the per-request timeout in seconds (default 60).
# Free tiers return frequent 503s; raise retries rather than switching models mid-experiment.
LLM_MAX_RETRIES=
LLM_TIMEOUT_SECONDS=

LLM_MODEL=

# ============================================================
# OPTIONAL: VOYAGE AI EMBEDDINGS / RERANKING
# ============================================================

# Required only if the team enables Voyage API embeddings or reranking.
VOYAGE_API_KEY=
# Optional pool (rate limits are per key): VOYAGE_API_KEY1..9 are rotated round-robin; VOYAGE_API_KEY is appended.
VOYAGE_API_KEY1=

# Model identifiers documented in the project proposal.
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_RERANK_MODEL=rerank-2.5

# Retrieval: bm25 (default, the pilot runs) or hybrid (BM25 + embeddings, fused with RRF; optional rerank).
# Every condition that retrieves uses the same index.  Record the choice with the results.
RETRIEVAL_MODE=bm25
# voyage (needs VOYAGE_API_KEY) or local (sentence-transformers, offline once cached; pip install -e .[embeddings])
EMBEDDING_BACKEND=voyage
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# none, voyage or local
RERANK_BACKEND=none
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional on-disk embedding cache (empty = in memory only).
EMBEDDING_CACHE_DIR=

# ============================================================
# OPTIONAL: GITHUB DATASET CONSTRUCTION
# ============================================================

# Read-only GitHub token, if needed for repository data collection.
# Public repository access may work without a token, subject to API limits.
GITHUB_TOKEN=

# ============================================================
# LOCAL EXPERIMENT CONFIGURATION
# ============================================================

# Record the selected experimental condition in the result logs.
# Proposal conditions: FULL, B1, A1, A2, A3 and the trivial baselines.  FULL, A1 and A3 need a memory store
# (scripts/run_experiment.py provides one; scripts/run_episode.py needs --memory).
EXPERIMENT_CONDITION=A2

# Random seed used by the experiment runner.
RANDOM_SEED=42

# Directory paths are relative to the project root unless otherwise configured.
DATASET_PATH=datasets/pilot_dev.jsonl
RESULTS_PATH=results/

# ============================================================
# LIMITS AND LOGGING (all optional; defaults shown)
# ============================================================

# Python interpreter that runs the target repository's tests (e.g. a boltons venv with
# pytest==8.4.2). Use the venv path itself, not its resolved symlink. Empty = current interpreter.
TEST_PYTHON=

# Per-pytest-run timeout in seconds.
TEST_TIMEOUT_SECONDS=120

# Number of evidence items returned per retrieval query.
RETRIEVAL_TOP_K=8

# Revisions allowed after a rejected repair (0 or 1).
MAX_REPAIR_REVISIONS=1

# Integrity Guard.  Cached-mutant catalogue (scripts/build_mutant_cache.py) given to the Guard; empty = the Guard
# generates mutants from the current source.
MUTANT_CACHE_PATH=
# UPDATE_TEST repairs whose strength no mutant can measure (no test in the touched files kills any, before or after):
# escalate (pilot behaviour) or allow (judge them on the Guard's other checks).  A team decision: record it.
GUARD_UNMEASURABLE_STRENGTH=escalate
# UPDATE_TEST retention threshold: share of the mutants killed by the pre-repair tests that the repaired tests must still
# kill, else the Guard rejects.  1.0 = none may be lost (pilot); the frozen final configuration uses 0.90.
GUARD_MIN_RETENTION=1.0

# Test-side patch rule: literal (default, the pilot: only expected literal values in `assert x ==/!= <literal>`
# and literal setup keyword arguments may change) or expected_value (also the expected side of an equality
# assertion may become any side-effect-free expression, the tested side unchanged).  Decide on dev; freeze it.
TEST_PATCH_RULE=literal

# Sandbox for every test run of an episode: auto (docker if an image is set and the daemon answers, else bubblewrap),
# docker or bwrap.  Image built from docker/pilot.Dockerfile; an episode's own docker_image wins when set.
SANDBOX_ISOLATION=auto
SANDBOX_DOCKER_IMAGE=

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Optional log file path. Leave empty to log to stderr only.
LOG_FILE=

# ============================================================
# NOTES
# ============================================================
# 1. Keep the same frozen model ID and comparable budgets across
#    Full, B1, A1, A2 and A3.
# 2. Log the actual model ID, experiment condition, seed, token usage,
#    tool calls and errors for every run.
# 3. Embeddings and reranking are optional; BM25 should work without
#    a Voyage API key.
# 4. These environment variable names are the project-wide
#    convention. The application must explicitly load and use them.
