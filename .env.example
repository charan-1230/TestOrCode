# TestOrCode environment configuration
# Copy this file to .env and fill in the values required for your setup.
# NEVER put real API keys in this file or commit .env to Git.

# ============================================================
# LLM PROVIDER
# ============================================================

# Examples: openai_compatible, gemini, ollama
LLM_PROVIDER=

# API key for the selected hosted provider.
# Leave empty only when the selected endpoint does not require a key.
LLM_API_KEY=

# OpenAI-compatible API base URL.
# Set this to the endpoint provided by your selected provider.
# Leave empty when using the SDK's default endpoint.
LLM_BASE_URL=

# Exact model ID selected by the team.
# Use a dated/frozen model ID when the provider offers one.
# Do not use a changing "latest" alias for controlled experiments.
LLM_MODEL=

# ============================================================
# OPTIONAL: VOYAGE AI EMBEDDINGS / RERANKING
# ============================================================

# Required only if the team enables Voyage API embeddings or reranking.
VOYAGE_API_KEY=

# Model identifiers documented in the project proposal.
VOYAGE_EMBEDDING_MODEL=voyage-code-3
VOYAGE_RERANK_MODEL=rerank-2.5

# ============================================================
# OPTIONAL: GITHUB DATASET CONSTRUCTION
# ============================================================

# Read-only GitHub token, if needed for repository data collection.
# Public repository access may work without a token, subject to API limits.
GITHUB_TOKEN=

# ============================================================
# LOCAL EXPERIMENT CONFIGURATION
# ============================================================

# Record the selected experimental condition in the result logs.
# Examples: Full, B1, A1, A2, A3
EXPERIMENT_CONDITION=B1

# Random seed used by the experiment runner.
RANDOM_SEED=42

# Directory paths are relative to the project root unless otherwise configured.
DATASET_PATH=datasets/pilot_dev.jsonl
RESULTS_PATH=results/

# ============================================================
# LIMITS AND LOGGING (all optional; defaults shown)
# ============================================================

# Per-pytest-run timeout in seconds.
TEST_TIMEOUT_SECONDS=120

# Number of evidence items returned per retrieval query.
RETRIEVAL_TOP_K=8

# Revisions allowed after a rejected repair (0 or 1).
MAX_REPAIR_REVISIONS=1

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Optional log file path. Leave empty to log to stderr only.
LOG_FILE=

# ============================================================
# NOTES
# ============================================================
# 1. Keep the same frozen model ID and comparable budgets across
#    Full, B1, A1, A2 and A3.
# 2. Log the actual model ID, experiment condition, seed, token usage,
#    tool calls and errors for every run.
# 3. Embeddings and reranking are optional; BM25 should work without
#    a Voyage API key.
# 4. These environment variable names are the project-wide
#    convention. The application must explicitly load and use them.
