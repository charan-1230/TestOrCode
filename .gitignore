# Ignore environment variable files
.env

# Ignore virtual environment directories:
myvenv/
.venv/

# Ignore Python bytecode files
*.py[cod]
__pycache__/
.pytest_cache/
.ruff_cache/


# Generated experiment output and logs (the directory itself is kept via .gitkeep)
results/*
!results/.gitkeep
!results/day1/
!results/day2/
!results/day3/
!results/mutants/
*.log

